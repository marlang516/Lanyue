{
  "name": "music-downloader",
  "version": "1.1.2",
  "description": "多平台音乐下载器 - 支持网易云/QQ音乐/B站/酷狗/酷我/咪咕/汽水/5sing",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --config vite.app.config.mjs",
    "start": "electron .",
    "build:app": "vite build --config vite.app.config.mjs",
    "build:legacy": "vite build && node scripts/postbuild.js",
    "build": "vite build --config vite.app.config.mjs && vite build && node scripts/postbuild.js",
    "package": "npm run build && electron-builder --config build/config.cjs --win --x64",
    "publish": "npm run build && electron-builder --config build/config.cjs --publish always",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test --test-concurrency=4 \"test/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage \"test/*.test.js\"",
    "bench": "node scripts/bench.js",
    "setup:hooks": "node scripts/setup-hooks.js",
    "lint": "eslint src/ test/ scripts/ci-doctor.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:renderer": "vue-tsc -p tsconfig.renderer.json --noEmit",
    "smoke:asar": "node scripts/smoke-asar.js",
    "package:smoke": "electron-builder --config build/smoke.config.cjs --win --x64 --dir --publish never",
    "smoke:release": "node scripts/smoke-test-manual.js .preview/release-smoke/win-unpacked/Lanyue.exe",
    "check:dead-deps": "node scripts/check-dead-deps.cjs",
    "check:icons": "node scripts/check-icons.cjs",
    "gen:icons": "node scripts/gen-icon.js",
    "audit:deps": "node scripts/audit-gate.cjs",
    "verify": "npm run lint && npm test && npm run check:dead-deps && npm run check:attack-surface && npm run check:icons && npm run build && npm run smoke:asar",
    "verify:release": "npm run verify && npm run smoke:release",
    "check:attack-surface": "node scripts/audit-attack-surface.cjs",
    "check:sdk-activity": "node scripts/check-sdk-activity.cjs"
  },
  "keywords": [
    "music",
    "downloader",
    "electron",
    "netease",
    "qq-music",
    "bilibili",
    "kugou",
    "kuwo",
    "migu",
    "webdav"
  ],
  "author": {
    "name": "揽乐",
    "email": "maliang04110233@gmail.com"
  },
  "desktopName": "lanyue.desktop",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlang516/Lanyue.git"
  },
  "homepage": "https://github.com/marlang516/Lanyue#readme",
  "bugs": {
    "url": "https://github.com/marlang516/Lanyue/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "^4.41.1",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.7.3",
    "music-metadata": "^12.2.0",
    "node-id3": "^0.2.9",
    "qq-music-api": "^1.1.2"
  },
  "overrides": {
    "qq-music-api": {
      "axios": "^0.34.0"
    },
    "proxy-addr": "^2.0.8",
    "moment": "^2.31.0",
    "qs": "^6.16.0",
    "node-forge": "^1.4.3",
    "music-metadata": "^12.2.0",
    "xml2js": "^0.6.2",
    "morgan": "^1.12.1",
    "on-headers": "^1.1.0",
    "tmp": "^0.2.7",
    "js-yaml": "^4.3.2",
    "ip-address": "^10.3.1",
    "esbuild": "0.25.10",
    "follow-redirects": "^1.16.3"
  }
}

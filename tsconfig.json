{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/shared/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}